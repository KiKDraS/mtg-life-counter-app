{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    ".opencode/docs/skills-settings-rules.md",
    ".opencode/docs/agent-knowledge-awareness.md"
  ],
  "permissions": [
    { "action": "shell", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "git *", "effect": "allow" },
    { "action": "shell", "resource": "npm *", "effect": "allow" },
    { "action": "shell", "resource": "pnpm *", "effect": "allow" },
    { "action": "shell", "resource": "rm *", "effect": "deny" },
    { "action": "shell", "resource": "grep *", "effect": "allow" },
    { "action": "playwright-test*", "resource": "*", "effect": "ask" }
  ],
  "plugins": ["@dietrichgebert/ponytail"],
  "mcp": {
    "servers": {
      "playwright-test": {
        "type": "local",
        "command": ["npx", "playwright", "run-test-mcp-server"],
        "disabled": false
      },
      "codegraph": {
        "type": "local",
        "command": ["npx", "@colbymchenry/codegraph", "serve", "--mcp"],
        "disabled": false
      },
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "headers": {
          "CONTEXT7_API_KEY": "{file:.opencode/secrets/context7-api-key}"
        },
        "disabled": false
      }
    }
  },
  "default_agent": "orchestrator"
}
